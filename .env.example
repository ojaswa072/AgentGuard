# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=agentguard
POSTGRES_PASSWORD=agentguard
POSTGRES_DB=agentguard
DATABASE_URL=postgresql+asyncpg://agentguard:agentguard@localhost:5432/agentguard

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
# Pin this after Week 1 smoke test — see agentcontext.md Section 4
OLLAMA_MODEL=phi4-mini

# ── Gemini (Optional — P1 only, never load-bearing for P0) ────────────────────
# GEMINI_API_KEY=your_key_here
# GEMINI_MODEL=gemini-2.0-flash-lite   # Check live docs at time of use — name churn risk

# ── Embedding model ───────────────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ── Agent runtime ─────────────────────────────────────────────────────────────
AGENT_MAX_STEPS=6
RETRIEVAL_TOP_K=3

# ── Backend ───────────────────────────────────────────────────────────────────
BACKEND_PORT=8000
LOG_LEVEL=INFO

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
