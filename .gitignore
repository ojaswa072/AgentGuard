# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
.venv/
venv/
ENV/
env/
.env
.env.*
!.env.example

# ── Pytest / Coverage ─────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── Mypy / Ruff ───────────────────────────────────────────────────────────────
.mypy_cache/
.ruff_cache/

# ── Alembic ───────────────────────────────────────────────────────────────────
# Never ignore alembic/versions — migrations are source code
# Ignore only the generated env bytecode if present
backend/db/alembic/__pycache__/

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.vite/
frontend/.env
frontend/.env.*
!frontend/.env.example
*.local

# ── Docker ────────────────────────────────────────────────────────────────────
# Never ignore docker-compose.yml — it's source
# But ignore local override if used
docker-compose.override.yml

# ── IDE / OS ──────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Jupyter (if any exploratory notebooks) ────────────────────────────────────
.ipynb_checkpoints/

# ── Secrets / Keys ────────────────────────────────────────────────────────────
*.pem
*.key
*.p12
